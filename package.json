{
  "name": "oppenly",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev:extension": "pnpm --filter @oppenly/extension dev",
    "dev:web": "pnpm --filter @oppenly/web dev",
    "dev:site": "pnpm --filter @oppenly/site dev",
    "web": "pnpm --filter @oppenly/web start",
    "build": "pnpm -r build",
    "build:extension": "pnpm --filter @oppenly/extension build",
    "zip:extension": "pnpm --filter @oppenly/extension zip",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "typescript": "5.9.3"
  }
}
